        "def generate_melody(length=8,scale=scale.MajorScale(\"C\")):\n",
        "  # Create a new music21 Stream to hold the melody.\n",
        "  melody = stream.Stream()\n",
        "\n",
        "  # Define a set of common musical durations (quarterLength).\n",
        "  # These correspond to eighth, quarter, dotted quarter, and half notes.\n",
        "  possible_durations = [0.5, 1.0, 1.5, 2.0]\n",
        "\n",
        "  for _ in range(length):\n",
        "    # Randomly select a pitch from the scale, ensuring it's within the C4-C5 range.\n",
        "    pitch = random.choice(scale.getPitches(\"C4\",\"C5\"))\n",
        "    # Randomly select a duration from the predefined list.\n",
        "    duration = random.choice(possible_durations)\n",
        "\n",
        "    # Create a new note with the selected pitch and duration.\n",
        "    new_note = note.Note(pitch)\n",
        "    new_note.duration.quarterLength = duration\n",
        "    # Add the note to the melody stream.\n",
        "    melody.append(new_note)\n",
        "\n",
        "  return melody"
      ],
