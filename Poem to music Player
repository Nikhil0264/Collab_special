        "def generate_poem(prompt,max_length=120):\n",
        "  # Encode the prompt text into input IDs for the GPT2 tokenizer.\n",
        "  input_ids = tokenizer.encode(prompt,return_tensors=\"pt\")\n",
        "\n",
        "  # Generate text using the loaded GPT2 model.\n",
        "  # max_length: The maximum length of the generated text.\n",
        "  # num_return_sequences: The number of sequences to generate.\n",
        "  # no_repeat_ngram_size: Avoids repetition of n-grams (sequences of words) of this size.\n",
        "  # top_k: Filters out low probability words from the generation pool.\n",
        "  # top_p: Filters out words by considering the smallest set of most probable words whose cumulative probability exceeds top_p.\n",
        "  # temperature: Controls the randomness of the generation (lower values make it more deterministic).\n",
        "  output = model.generate(\n",
        "      input_ids,\n",
        "      max_length = max_length,\n",
        "      num_return_sequences = 1,\n",
        "      no_repeat_ngram_size = 2,\n",
        "      top_k = 50,\n",
        "      top_p = 0.95,\n",
        "      temperature = 0.7\n",
        "  )\n",
        "\n",
        "  # Decode the generated output IDs back into human-readable text.\n",
        "  # skip_special_tokens=True removes any special tokens (like padding or end-of-sentence tokens).\n",
        "  generated_text = tokenizer.decode(output[0],skip_special_tokens=True)\n",
        "  return generated_text"
      ],
