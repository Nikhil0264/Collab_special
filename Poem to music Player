        "def poem_to_melody(poem,scale=scale.MajorScale(\"C\")):\n",
        "  words = poem.split()\n",
        "  melody = stream.Stream()\n",
        "\n",
        "  # Define possible musical durations to map word lengths to.\n",
        "  # These correspond to eighth, quarter, dotted quarter, and half notes.\n",
        "  duration_map = [0.5, 1.0, 1.5, 2.0]\n",
        "\n",
        "  # Process up to the first 16 words of the poem.\n",
        "  for i, word in enumerate(words[:16]): # Increased to 16 words for potentially longer melodies\n",
        "    # Map word length to a pitch degree within the scale.\n",
        "    # Using modulo 7 ensures the degree is within the 7-note scale (1-indexed).\n",
        "    degree = (len(word) % 7) + 1\n",
        "    pitch_obj = scale.pitchFromDegree(degree)\n",
        "    # Set the octave for the pitch, e.g., to the 4th octave for a middle range.\n",
        "    pitch_obj.octave = 4\n",
        "\n",
        "    # Map word length to a musical duration.\n",
        "    # Using modulo to select from the predefined duration_map for musicality.\n",
        "    duration = duration_map[len(word) % len(duration_map)]\n",
        "\n",
        "    new_note = note.Note(pitch_obj)\n",
        "    new_note.duration.quarterLength = duration\n",
        "\n",
        "    melody.append(new_note)\n",
        "\n",
        "  return melody"
      ],
